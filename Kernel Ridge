from sklearn.kernel_ridge import KernelRidge
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
import pandas as pd

data = pd.read_excel("encrypted_data_with_challenges12.xlsx")

data["Challenge bits"] = data["Challenge bits"].apply(lambda x: int(''.join(filter(str.isdigit, x)), 2))
data["Encrypted Response"] = data["Encrypted Response"].apply(lambda x: int(str(x)[:64], 2))


X = data["Challenge bits"].values.reshape(-1, 1)  # Features
y = data["Encrypted Response"]  # Target variable


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)


X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, random_state=42)


krr_model = KernelRidge(alpha=1.0, kernel='rbf')
krr_model.fit(X_train, y_train)


y_pred_train = krr_model.predict(X_train)
y_pred_test = krr_model.predict(X_test)


training_score = krr_model.score(X_train, y_train)
testing_score = krr_model.score(X_test, y_test)

print("Training Score:", training_score)
print("Testing Score:", testing_score)
