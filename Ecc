def mod_inv(mod, num):
    global t1
    q = 0
    r = 1
    t1 = 0
    t2 = 1
    t = 0
    num = num % mod
    a = mod
    b = num
    while r != 0:
        q = a//b
        r = a%b
        t = t1 - (t2*q)
        a, b = b, r
        t1, t2 = t2, t
    return t1 % mod

def point_adding(modval, Gx, Gy, xp, yp):
    xr = 0
    yr = 0
    if (Gx, Gy) == (xp, yp):
        s = ((3 * (Gx**2)) + a) * (mod_inv(modval, (2*Gy))) % modval
    else:
        s = ((yp - Gy) * (mod_inv(modval, (xp - Gx)))) % modval

    xr = ((s**2) - (xp+Gx)) % modval
    yr = (s * (xp - xr) - yp) % modval

    return xr, yr

def point_mul(k, modval, Gx, Gy):
    xp = Gx
    yp = Gy
    while k!=1:
        xr, yr = point_adding(modval, Gx, Gy, xp, yp)
        xp, yp = xr, yr
        k = k-1
    return xp, yp

